# API key for the OpenAI-compatible LLM provider (required at runtime)
LLM_API_KEY=

# Base URL of the OpenAI-compatible endpoint (required at runtime)
# Example: https://api.openai.com/v1
LLM_BASE_URL=

# Model name to use for reviews (required at runtime)
# Example: gpt-4o-mini
LLM_MODEL=

# Timeout (ms) for a single LLM request. Defaults to 30000.
LLM_TIMEOUT_MS=

# Maximum number of retries when the LLM returns 5xx or rate-limited responses. Defaults to 2.
LLM_MAX_RETRIES=

# Maximum code snippet length in characters. Defaults to 20000.
MAX_CODE_LENGTH=

# Port for the API server. Defaults to 3000.
PORT=
